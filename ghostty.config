# Font
font-family = InconsolataM Nerd Font Mono
font-size = 20

# Theme (Solarized Dark - matches iTerm2 config)
theme = iTerm2 Solarized Dark

# Cursor
cursor-style-blink = false

# Window
background-opacity = 0.925
background-blur = 5
window-width = 80
window-height = 90

# Quick terminal (replaces iTerm2 hotkey window Cmd+J)
keybind = global:super+j=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-autohide = true

# Scrollback
scrollback-limit = 10000000

# Bell (dock bounce + title badge)
bell-features = attention
bell-features = title

# macOS Option key behavior (Normal, not Esc+)
macos-option-as-alt = false
